{
    "name": "belaaredj/filament-localized",
    "description": "Multilingual infrastructure plugin for Filament 5.",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "filament-plugin",
        "multilingual",
        "localization",
        "translations"
    ],
    "homepage": "https://github.com/chiina14/filament-localized",
    "support": {
        "issues": "https://github.com/chiina14/filament-localized/issues",
        "source": "https://github.com/chiina14/filament-localized"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Belaaredj",
            "email": "Belaaredj14bel@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Belaaredj\\FilamentLocalized\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Belaaredj\\FilamentLocalized\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "lint:test": "pint --test",
        "refactor": "rector",
        "refactor:test": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Belaaredj\\FilamentLocalized\\FilamentLocalizedServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "prefer-stable": true
}
